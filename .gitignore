# SafeMAPS — Version Control Exclusion List

# Environment & Private Configuration
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Dependencies
node_modules/
jspm_packages/
.npm/
.pnp/
.pnp.js
venv/
env/
.venv/
__pycache__/
*.pyc

# Distribution & Build Artifacts
dist/
build/
.next/
out/
.docusaurus/
.cache/
public/build/
.serverless/
.fusebox/
.vike/
backend/dist/
frontend_app/dist/

# OS Specific
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDEs & Editor Specific
.idea/
.vscode/
*.swp
*.swo
*.swn
.project
.classpath
.settings/
.sublime-project
.sublime-workspace

# Logs and Databases
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
*.sqlite
*.db
infrastructure-pgdata/

# Data Pipeline & OSM files — large binaries, never commit
data_pipeline/data/*.osm
data_pipeline/data/*.pbf
data_pipeline/data/*.bz2
data_pipeline/*.osm.pbf
data_pipeline/*.pbf
!data_pipeline/data/.gitkeep

# Project Specific
.gemini/
brain/
/tmp/

# Incident scraper cache files
data_pipeline/.incident_cache/
data_pipeline/incident_cache_*.json

# CPCB data cache
data_pipeline/.cpcb_cache/

# ML model weights (large binary files — train locally)
data_pipeline/models/
data_pipeline/*.pt
data_pipeline/*.pth

# Migration artifacts
restore_list.txt
restore_list_filtered.txt
safemaps_data_migration.sql
safemaps_deploy.dump
